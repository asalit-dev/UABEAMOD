<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="360" Height="190"
        x:Class="UABEAvalonia.LzmaSizeWindow"
        Title="LZMA Size"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="is by Loki x Ryx"
               HorizontalAlignment="Center"
               FontSize="18"
               FontWeight="Bold"
               Foreground="#87CEEB" />

    <TextBox Name="boxFinalSize"
             Height="42"
             FontSize="16"
             Watermark="Final size in bytes"
             HorizontalContentAlignment="Center"
             VerticalContentAlignment="Center" />

    <Button Name="btnOk"
            Height="40"
            HorizontalAlignment="Stretch"
            Background="#F44336"
            Foreground="#87CEEB"
            FontWeight="Bold"
            FontSize="16">OK</Button>
  </StackPanel>
</Window>

